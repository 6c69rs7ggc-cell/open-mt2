AUTH_SERVER_PORT=11002
AUTH_SERVER_ADDRESS=127.0.0.1
GAME_SERVER_PORT=13001
GAME_SERVER_ADDRESS=127.0.0.1
# IPv4 address advertised to clients in the character list; use a reachable public IPv4 for remote clients (not a DNS name).
REAL_SERVER_ADDRESS=127.0.0.1
LOG_LEVEL=debug

DB_PORT=3306
DB_HOST=127.0.0.1
# Replace these placeholders with strong, unique values before running outside CI.
DB_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
SEED_ADMIN_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_STRONG_PASSWORD
AUTH_DB_DATABASE_NAME=auth
GAME_DB_DATABASE_NAME=game
DB_USER=root

CACHE_PORT=6379
CACHE_HOST=127.0.0.1

# Comma-separated database account IDs allowed to use privileged slash commands.
# Leave empty to disable all GM commands until your account ID is configured.
GM_ACCOUNT_IDS=
